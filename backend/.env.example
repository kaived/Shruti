# Local development. Docker Compose supplies storage/Redis/database settings.
SHRUTI_DATA_DIR=./data
SHRUTI_DATABASE_URL=
SHRUTI_REDIS_URL=redis://localhost:6379/0
SHRUTI_ALLOWED_ORIGINS=["http://localhost:5173"]
SHRUTI_MAX_UPLOAD_BYTES=524288000
SHRUTI_MAX_DURATION_SECONDS=7200
SHRUTI_JOB_TIMEOUT_SECONDS=3600
SHRUTI_MAX_ATTEMPTS=3
# Leave unset until a REAL provider factory is implemented. No mock inference default.
SHRUTI_PROVIDER_FACTORY=
SHRUTI_PROVIDER_REVISION=unconfigured
SHRUTI_COOKIE_SECURE=false
# Optional shared upload key. Set this and add ingress limits before public exposure.
SHRUTI_UPLOAD_KEY=
