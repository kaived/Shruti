# Shruti backend configuration template.
# Copy to .env.development (local) or .env.production (used by deploy/gcp.sh) and fill in.
# Never commit the filled-in files: .env.* is git-ignored except this template.
# The same variable names are used by the backend, compose.yaml, deploy/gcp.sh and Cloud Run.

# --- Required: storage and queue (API + worker) ---
# Neon Postgres URL. Leave empty locally to use SQLite under SHRUTI_DATA_DIR.
SHRUTI_DB_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Upstash Redis TCP/TLS URL (rediss://), not the REST URL.
SHRUTI_REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Required: access control (API) ---
# Shared key users type into the studio to upload. Use a long random string.
SHRUTI_UPLOAD_KEY=replace-with-a-long-random-string
# true behind HTTPS (Cloud Run); false only for plain-http local development.
SHRUTI_COOKIE_SECURE=true

# --- Required: AI providers (worker) ---
SHRUTI_PROVIDER_FACTORY=ai.factory:create_providers
# Bump when models, prompts or thresholds change so cached stage results are not reused.
SHRUTI_PROVIDER_REVISION=whisper-large-v3-groq
# Groq: Whisper large-v3 speech recognition, English respelling and EN/HI translation.
GROQ_API_KEY=gsk_replace_me
# Hugging Face token whose account accepted pyannote/speaker-diarization-community-1 terms.
SHRUTI_HF_TOKEN=hf_replace_me

# --- Optional (defaults shown) ---
# Groq chat model for code-switch respelling and translation.
# SHRUTI_TRANSLATION_MODEL=openai/gpt-oss-120b
# SHRUTI_DATA_DIR=data
# SHRUTI_MAX_UPLOAD_BYTES=524288000
# SHRUTI_MAX_DURATION_SECONDS=7200
# Job time limit in seconds. deploy/gcp.sh sets 10800 (3 h) on both API and worker.
# SHRUTI_JOB_TIMEOUT_SECONDS=3600
# SHRUTI_MAX_ATTEMPTS=3
# Browser origins allowed to call the API (JSON list). deploy/gcp.sh sets this for you.
# SHRUTI_ALLOWED_ORIGINS=["http://localhost:5173"]
# Comma-separated browser origins for deploy/gcp.sh; it applies them to both the
# Cloud Run API and the direct-upload Cloud Storage bucket. No paths or trailing slashes.
# Defaults already include both production sites and localhost development origins.
# FRONTEND_ORIGINS=https://shruti.orbionixtech.com,https://shruti-ets.pages.dev

# --- Frontend: see frontend/.env.example (VITE_API_BASE_URL) ---
