# Copy to .env.development and .env.production (git-ignored), or set in Cloudflare Pages.
# API origin only: no /api path and no trailing slash. The versioned prefix (/api/v1)
# lives in src/shared/config. Leave empty to use the Vite dev proxy to 127.0.0.1:8000.
# Never put secrets here: every VITE_ variable is embedded in the public JavaScript bundle.
VITE_API_BASE_URL=https://shruti-api-PROJECT_NUMBER.REGION.run.app
